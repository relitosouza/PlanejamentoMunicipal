# Database Setup (Supabase)
# Transaction Mode (Port 6543) - Used for application connection
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Mode (Port 5432) - Used for Prisma migrations
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Authentication
# Generate with: npx auth secret
AUTH_SECRET="your-auth-secret-minimum-32-characters-here"

# Claude AI API (if applicable)
ANTHROPIC_API_KEY=""
